includes:
    - ../../.Build/vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - phpstan-baseline.neon

parameters:
  phpVersion: 80100

  level: 9

  paths:
    - ../../Classes
    - ../../Configuration
    - ../../Tests
    - ../../ext_localconf.php

  ignoreErrors:
    - identifiers:
        - method.internalClass
    -
      identifier: staticMethod.alreadyNarrowedType
      path: '../../Tests/'
